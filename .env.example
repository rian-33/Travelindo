# Travelindo Environment Variables
# Copy this file to .env.local and fill in your values

# API Configuration
VITE_API_URL=http://localhost:5000/api

# Cloudinary Configuration (Image CDN)
# Note: jangan gunakan prefix VITE_ untuk API_SECRET karena
# semua variabel ber-prefix VITE_ terekspos ke bundle frontend.
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_API_KEY=your_api_key

# Backend Environment (for server.js)
MONGO_URI=mongodb://localhost:27017/travelindo
PORT=5000
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_REFRESH_SECRET=your_refresh_secret_min_32_chars
NODE_ENV=development